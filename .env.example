# Runtime
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/pay-cycle

# Authentication
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# Application
APP_NAME=PayCycle
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# Media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Interswitch payment gateway
INTERSWITCH_MERCHANT_CODE=
INTERSWITCH_MERCHANT_ENCODED_VALUE=
INTERSWITCH_PROVIDER_ENCODED_VALUE=
INTERSWITCH_CLIENT_ID=
INTERSWITCH_CLIENT_SECRET=
INTERSWITCH_BASE_URL=https://sandbox.interswitchng.com
INTERSWITCH_PASSPORT_URL=https://passport.interswitchng.com
INTERSWITCH_PAYABLE_CODE=Default_Payable_MERCHANT_CODE
